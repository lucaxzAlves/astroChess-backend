{
  "name": "aura-chess-backend",
  "version": "1.0.0",
  "description": "Backend Node.js com TypeScript para um SaaS de analise de partidas de xadrez.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch --exclude node_modules --exclude dist --exclude .git --exclude coverage src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "import:puzzles": "tsx src/modules/pattern-forge/scripts/import-puzzles.ts",
    "test:classification": "tsx --test src/chess/move-classifier.test.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "chess",
    "saas",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "chess.js": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
